# ================================
# E-COMMERCE BACKEND - ENVIRONMENT VARIABLES
# ================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to version control

# ================================
# DATABASE CONFIGURATION
# ================================

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecommerce
DB_USERNAME=ecommerce
DB_PASSWORD=your_mysql_password_here

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=ecommerce
MONGO_USERNAME=root
MONGO_PASSWORD=your_mongo_password_here
MONGO_AUTH_SOURCE=admin

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# ================================
# JWT SECURITY CONFIGURATION
# ================================

# JWT Secret Key (Base64 encoded, minimum 256 bits)
# Generate new key: openssl rand -base64 64
JWT_SECRET_BASE64=your_jwt_secret_base64_encoded_here

# JWT Issuer
JWT_ISSUER=ecommerce-backend

# JWT Token TTL (in seconds)
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=604800

# ================================
# OAUTH2 CONFIGURATION
# ================================

# Google OAuth2 Credentials
# Get credentials from: https://console.cloud.google.com/apis/credentials
OAUTH2_GOOGLE_CLIENT_ID=your_google_client_id_here
OAUTH2_GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# OAuth2 Success Redirect URL
OAUTH2_SUCCESS_REDIRECT_URL=http://localhost:3000/oauth2/callback

# ================================
# APPLICATION CONFIGURATION
# ================================

# Server Port
SERVER_PORT=8080

# File Upload Directory
UPLOAD_DIR=./uploads

# Max File Upload Size
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=20MB

# ================================
# PAYMENT GATEWAY CONFIGURATION
# ================================

# VNPay Payment Gateway
# Get credentials from: https://sandbox.vnpayment.vn/merchantv2/
VNPAY_TMN_CODE=your_vnpay_tmn_code_here
VNPAY_HASH_SECRET=your_vnpay_hash_secret_here
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/v1/payment/vnpay/callback
VNPAY_VERSION=2.1.0
VNPAY_COMMAND=pay

# ================================
# EMAIL CONFIGURATION
# ================================

# SMTP Server Configuration
# For Gmail: Use App Password (not regular password)
# Generate App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password-here

# Email Sender Information
EMAIL_FROM=noreply@ecommerce.com
EMAIL_FROM_NAME=E-Commerce Platform

# Alternative SMTP Providers:
# - Mailtrap (for testing): smtp.mailtrap.io, port 2525
# - SendGrid: smtp.sendgrid.net, port 587
# - AWS SES: email-smtp.{region}.amazonaws.com, port 587
# - Mailgun: smtp.mailgun.org, port 587

# ================================
# DOCKER COMPOSE OVERRIDES
# ================================
# These are used by docker-compose.yml

# MySQL Docker
DOCKER_MYSQL_ROOT_PASSWORD=your_docker_mysql_root_password_here

# MongoDB Docker
DOCKER_MONGO_ROOT_PASSWORD=your_docker_mongo_root_password_here
